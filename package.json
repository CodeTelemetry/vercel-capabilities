{
  "name": "vercel-capabilities",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated, reproducible Vercel capability acceptance fixtures",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "node --test --test-timeout=20000 scripts/*.test.mjs && turbo run test",
    "ci": "turbo run test --summarize",
    "collect:checks": "node scripts/collect-checks.mjs"
  },
  "devDependencies": { "turbo": "2.11.10" }
}
